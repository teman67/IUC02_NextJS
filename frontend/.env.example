# ──────────────────────────────────────────────────────────────────────────────
# IUC02 Frontend – Next.js environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git (it is already in .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# URL of the FastAPI backend.  In local dev this is http://localhost:8000.
# On production (e.g. Railway / Render) replace with the public service URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL (visible in Supabase → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Anonymous / public key – safe to expose to the browser.
# Make sure Row Level Security (RLS) is enabled on every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# (Optional) Service-role key – NEVER prefix with NEXT_PUBLIC_.
# Use only in server-side API routes (e.g. track-visit) for elevated permissions.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Geo-IP ────────────────────────────────────────────────────────────────────
# ipinfo.io API token for geolocation in visit tracking (optional).
# Without a token the app falls back to the free ip-api.com service.
IPINFO_API_TOKEN=

# ── OpenAI (server-side only – do NOT prefix with NEXT_PUBLIC_) ───────────────
OPENAI_API_KEY=sk-...
